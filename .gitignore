.env
.env.local
.env.*.local
*.key
*.pem

# ==============================================================================
# 2. PYTHON & VIRTUAL ENVIRONMENTS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (uv, venv, conda)
.venv/
venv/
ENV/
env/
.envrc

# ==============================================================================
# 3. MACHINE LEARNING & HEAVY CACHES
# ==============================================================================
# Hugging Face & Transformers cache (prevents uploading 6GB+ of model weights)
.cache/
.huggingface/
*.ckpt
*.safetensors
*.bin
*.onnx

# ==============================================================================
# 4. PROJECT-SPECIFIC GENERATED FILES
# ==============================================================================
# Learned graph state (regenerates on the fly, don't commit dynamic state)
.sem_tool_graph.json
trajectories.json

# Generated charts and plots (keep the repo clean; put final ones in /results)
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# Exception: Allow the results folder if you want to commit final defense charts
# (Uncomment the next line if you want to keep your final charts in version control)
# !results/

# ==============================================================================
# 5. TESTING & COVERAGE
# ==============================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==============================================================================
# 6. IDE & EDITOR FILES
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
# 7. LOGS & TEMP
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*